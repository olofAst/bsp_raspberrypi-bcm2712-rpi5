################################################################################################
##
## Build file for QNX Neutrino 7.1 on the Raspberry Pi 5 (BCM2712, Cortex-A76)
##
## This is the SDP 7.1 port of the SDP 8.0 BSP. Compared to the 8.0 image:
##   - there is no BCM2712 PCIe hardware module for SDP 7.1, so pci-server is not used.
##     The RP1 I/O controller is used as left configured by the Pi 5 firmware
##     ("pciex4_reset=0" in config.txt is REQUIRED) and msix-rp1 programs its interrupts.
##   - USB uses the stock SDP 7.1 xHCI driver (devu-hcd-xhci.so) on the two RP1 controllers.
##   - networking is io-pkt with USB Ethernet adapters (no driver for the RP1 on-board GEM).
##   - I2C, SPI, Wi-Fi and on-board Ethernet are not ported.
##
################################################################################################

[-optional]
[+keeplinked]
[image=0x80000]
[virtual=aarch64le,raw -compress] boot = {
    # Startup parameters
    #  '-v'           -> increase verbosity (repeat for more)
    #  '-W [timeout]' -> enable the watchdog (timeout in ms). If you add it, you MUST also
    #                    uncomment the wdtkick line in the startup script below.
    startup-bcm2712-rpi5 -vv
    PATH=/proc/boot:/sbin:/bin:/usr/bin:/usr/sbin LD_LIBRARY_PATH=/proc/boot:/lib:/usr/lib:/lib/dll procnto-smp-instr -v
}

[+script] startup-script = {
    SYSNAME=nto
    TERM=qansi
    ENV=/etc/profile

    procmgr_symlink ../../proc/boot/ldqnx-64.so.2 /usr/lib/ldqnx-64.so.2

    display_msg Welcome to QNX Neutrino 7.1 on the Raspberry Pi 5 (BCM2712 Cortex-A76)

    slogger2
    pipe
    dumper -d /dev/shmem &
    mqueue

    #######################################################################
    ## WatchDog utility
    ## If startup is given the -W parameter then wdtkick MUST be started here
    #######################################################################
    # display_msg Starting watchdog ...
    # wdtkick -W0x24:0x5A028E4C -W0x1c:0x5A000020

    #######################################################################
    ## Random service
    #######################################################################
    random -t
    waitfor /dev/random 5

    #######################################################################
    ## Debug console serial driver (UART10, 3-pin debug header between the HDMI ports)
    #######################################################################
    display_msg Starting serial driver (/dev/ser10)
    devc-serpl011 -b115200 -c44236800 -e -F -u10 0x107d001000^2,153
    waitfor /dev/ser10 4
    reopen /dev/ser10

    #######################################################################
    ## SD memory card driver
    #######################################################################
    display_msg Starting SDMMC driver (/dev/sd0)
    devb-sdmmc-bcm2712 sdio addr=0x1000fff000,irq=305 disk name=sd &
    waitfor /dev/sd0 4

    #######################################################################
    ## RP1 I/O controller interrupts (needed by everything that lives in RP1: USB, UARTs, ...)
    #######################################################################
    ksh /proc/boot/rp1_start.sh

    #######################################################################
    ## USB host controllers
    #######################################################################
    ksh /proc/boot/usb_start.sh

    #######################################################################
    ## Network (USB Ethernet adapters), remote debug
    #######################################################################
    ksh /proc/boot/net_start.sh

    #######################################################################
    ## Fan
    #######################################################################
    ksh /proc/boot/fan_start.sh

    #######################################################################
    ## Customize startup components
    #######################################################################
    ksh /proc/boot/customize_startup.sh

    display_msg Starting shell ...
    [+session] ksh &
}

[uid=0 gid=0]

[type=link] /bin/sh=/bin/ksh
[type=link] /tmp=/dev/shmem
[type=link] /dev/console=/dev/ser10
[type=link] /var/log=/tmp
[type=link] /usr/tmp=/tmp
[type=link] /etc/resolv.conf=/tmp/resolv.conf


################################################################################################
## Scripts
################################################################################################
rp1_start.sh = {
#!/bin/sh
# Program the RP1 MSI-X vectors: 6=Ethernet 31=USB host 0 36=USB host 1,
# 25/42..46=UART0..5. RP1 irq n is delivered as GIC interrupt 160+n.
echo "Configuring RP1 interrupts ..."
if msix-rp1 -i 6,31,36,25,42,43,44,45,46; then
    echo ok > /dev/shmem/rp1_ok
else
    echo "RP1 is not usable: USB, RP1 UARTs and RP1 GPIO are disabled."
    echo "  msix-rp1 -d       dump the PCIe/RP1 state"
    echo "  msix-rp1 -f -vv   try to configure the RP1 link here, then: ksh /proc/boot/usb_start.sh"
fi
}

usb_start.sh = {
#!/bin/sh
if [ ! -e /dev/shmem/rp1_ok ]; then
    # second chance when started by hand after "msix-rp1 -f"
    msix-rp1 -i 6,31,36,25,42,43,44,45,46 && echo ok > /dev/shmem/rp1_ok
fi
if [ ! -e /dev/shmem/rp1_ok ]; then
    echo "Not starting USB: RP1 is not configured"
    exit 1
fi
echo "Starting USB xHCI host controllers (/dev/usb/io-usb-otg) ..."

# VBUS enable / over-current pins of the four type A ports
gpio-rp1 set 42 a2 pn
gpio-rp1 set 43 a2 pu

# RP1 has two DWC3 xHCI controllers (each serves one USB3 and one USB2 type A port).
# bmstr: RP1 sees host RAM at <PCI window base> + physical address (normally 0x1000000000);
# msix-rp1 -B reads the window base back from the PCIe root complex.
BMSTR=$(msix-rp1 -B)
io-usb-otg -d xhci ioport=0x1f00200000,irq=191,iosize=0x100000,bmstr=$BMSTR,ioport=0x1f00300000,irq=196,iosize=0x100000,bmstr=$BMSTR
waitfor /dev/usb/io-usb-otg 10

# USB mass storage (shows up as /dev/umass0) and HID devices
devb-umass cam pnp blk cache=2m dos exe=all &
io-hid -d usb
}

net_start.sh = {
#!/bin/sh
# There is no SDP 7.1 driver for the RP1 on-board Ethernet MAC. USB Ethernet adapters
# (ASIX AX88xxx, SMSC LAN95xx, CDC-ECM) work through the USB host controllers.
if [ -e /dev/usb/io-usb-otg ]; then
    echo "Starting network stack ..."
    io-pkt-v6-hc -d asix -d smsc9500 -d usbnet
    if_up -p -r 3 en0 && dhclient -m -lf /dev/shmem/dhclient.leases -pf /dev/shmem/dhclient.pid -nw en0
else
    echo "No USB: starting network stack without drivers"
    io-pkt-v6-hc
fi

devc-pty
qconn
}

fan_start.sh = {
#!/bin/sh
echo "Starting fan control driver ..."
# gpio 45 is configured as PWM1_CHAN3 to drive the fan
gpio-rp1 set 45 a0 pd
fan-rpi5
waitfor /dev/fan 4
echo 200 > /dev/fan
}

uart4_console.sh = {
#!/bin/sh
echo "Start uart4 (gpio12-pin32, gpio13-pin33) console"
gpio-rp1 set 12 a2 pn
gpio-rp1 set 13 a2 pu
devc-serpl011 -b115200 -c50000000 -e -F -u4 0x1f00040000^2,205
waitfor /dev/ser4 4
on -t /dev/ser4 /bin/sh
}

uart2_console.sh = {
#!/bin/sh
echo "Start uart2 (gpio4-pin7, gpio5-pin29) console"
gpio-rp1 set 4 a2 pn
gpio-rp1 set 5 a2 pu
devc-serpl011 -b115200 -c50000000 -e -F -u2 0x1f00038000^2,203
waitfor /dev/ser2 4
on -t /dev/ser2 /bin/sh
}

customize_startup.sh = {
#!/bin/sh
if [ -e /scripts/board_startup.sh ]; then
    echo "Starting board customize script ..."
    ksh /scripts/board_startup.sh
fi
}


################################################################################################
## Shared libraries
################################################################################################
ldqnx-64.so.2=ldqnx-64.so.2

/lib/libc.so=libc.so
/lib/libgcc_s.so=libgcc_s.so
/lib/libm.so=libm.so
/lib/libregex.so=libregex.so
/lib/libqh.so=libqh.so
/lib/libpps.so=libpps.so
/lib/libsecpol.so=libsecpol.so
/lib/libslog2.so=libslog2.so
/lib/libslog2parse.so=libslog2parse.so
/lib/libtracelog.so=libtracelog.so
/lib/libsocket.so=libsocket.so

/usr/lib/libz.so=libz.so
/usr/lib/libncursesw.so=libncursesw.so
/usr/lib/libpanelw.so=libpanelw.so
/usr/lib/libbacktrace.so=libbacktrace.so
/usr/lib/libc++.so=libc++.so
/usr/lib/libcrypto.so=libcrypto.so
/usr/lib/libssl.so=libssl.so
/usr/lib/libqcrypto.so=libqcrypto.so
/usr/lib/libnbutil.so=libnbutil.so
/usr/lib/librpc.so=librpc.so

/lib/dll/qcrypto-openssl.so=qcrypto-openssl.so

[perms=0644] /etc/qcrypto.conf = {
openssl     tags=*
}


################################################################################################
## Serial driver
################################################################################################
/sbin/devc-serpl011=devc-serpl011
/sbin/devc-pty=devc-pty


################################################################################################
## Block driver (SD card) and filesystems
################################################################################################
/sbin/devb-sdmmc-bcm2712=devb-sdmmc-bcm2712

/lib/libcam.so=libcam.so
/lib/dll/io-blk.so=io-blk.so
/lib/dll/cam-disk.so=cam-disk.so
/lib/dll/fs-qnx6.so=fs-qnx6.so
/lib/dll/fs-dos.so=fs-dos.so

/sbin/fdisk=fdisk
/sbin/mkdosfs=mkdosfs
/sbin/mkqnx6fs=mkqnx6fs
/sbin/chkqnx6fs=chkqnx6fs


################################################################################################
## USB host
################################################################################################
/sbin/io-usb-otg=io-usb-otg
/sbin/usb=usb
/sbin/devb-umass=devb-umass
/sbin/io-hid=io-hid

/lib/libusbdi.so=libusbdi.so
/lib/libhiddi.so=libhiddi.so
/lib/dll/devu-hcd-xhci.so=devu-hcd-xhci.so
/lib/dll/devh-usb.so=devh-usb.so


################################################################################################
## Network (io-pkt, USB Ethernet adapters)
################################################################################################
/sbin/io-pkt-v6-hc=io-pkt-v6-hc
/sbin/ifconfig=ifconfig
/sbin/route=route
/sbin/dhclient=dhclient
/usr/sbin/if_up=if_up
/usr/sbin/nicinfo=nicinfo
/usr/bin/netstat=netstat
/usr/bin/ping=ping

/lib/dll/devnp-asix.so=devnp-asix.so
/lib/dll/devnp-smsc9500.so=devnp-smsc9500.so
/lib/dll/devnp-usbnet.so=devnp-usbnet.so

[search=${QNX_TARGET}/sbin perms=a+x] /sbin/dhclient-script=dhclient-script
[search=${QNX_TARGET}/etc] /etc/dhclient.conf=dhclient.conf
/etc/hosts=${QNX_TARGET}/etc/hosts
/etc/services=${QNX_TARGET}/etc/services
/etc/protocols=${QNX_TARGET}/etc/protocols


################################################################################################
## Remote debug
################################################################################################
/usr/sbin/qconn=qconn
/usr/bin/pdebug=pdebug


################################################################################################
## Board utilities
################################################################################################
/bin/wdtkick=wdtkick
/bin/gpio-aon-bcm=gpio-aon-bcm
/bin/gpio-bcm=gpio-bcm
/bin/gpio-rp1=gpio-rp1
/bin/mbox-bcm=mbox-bcm
/sbin/msix-rp1=msix-rp1
/sbin/fan-rpi5=fan-rpi5
/bin/fbdemo-rpi5=fbdemo-rpi5
/bin/peek=peek


################################################################################################
## Users
################################################################################################
[uid=0 gid=0 perms=0644] /etc/passwd = {
root:x:0:0:Superuser:/:/bin/sh
qnxuser:x:1000:1000:QNX User:/home/qnxuser:/bin/sh
}

